# Ubuntu 20.04 (focal) verification image: distro Python 3.8 + PostgreSQL 12 + psycopg2/pytest from apt.
# Pins nothing beyond the release; the exact package versions are printed by run-tests-in-container.sh.
FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8 LC_ALL=C.UTF-8
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates postgresql-12 python3 python3-psycopg2 python3-pytest gnupg \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY migrations ./migrations
COPY src ./src
COPY tests ./tests
COPY scripts/run-tests-in-container.sh ./scripts/run-tests-in-container.sh

ENTRYPOINT ["/app/scripts/run-tests-in-container.sh"]
